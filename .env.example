# Copy to .env (which git ignores) and fill in. Never commit the real .env.

# Required: the password for your dashboard. Use something long.
APP_PASSWORD=
# Optional: extra secret for signing your login cookie.
SECRET_KEY=

# SEC asks for contact info in the User-Agent, or it blocks requests.
USER_AGENT=signal-desk/0.2 (contact: you@example.com)

WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMD,AMZN,META,GOOGL

# Congressional trades (free key from financialmodelingprep.com)
FMP_API_KEY=

# AI sentiment with Claude (key from console.anthropic.com). Each headline/post is scored once and cached.
AI_SENTIMENT=0
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is ~40x cheaper per token than the default if cost matters more than nuance.
AI_MODEL=claude-opus-5-5

# Alerts
ALERT_INTERVAL_MIN=15
ALERT_DELTA=25
# Phone push: install the ntfy app, subscribe to a long random topic, put its URL here.
ALERT_WEBHOOK_URL=

DEMO_MODE=0

# ---- Autotrader ----
# Pick Off / Ask me first / Automatic in the dashboard. Rules and limits live in strategy.toml.
TRADER_ENABLED=1
# Must be 1 before "Automatic" can place Robinhood orders without asking you. Leave 0 until
# you've run "Ask me first" for a few weeks and the backtest holds up.
ALLOW_LIVE_AUTO=0
# Address your browser uses to reach this app (Robinhood's login sends you back here).
PUBLIC_URL=http://127.0.0.1:8000
# Where the Robinhood login token is stored (file is created with owner-only permissions).
DATA_DIR=.
